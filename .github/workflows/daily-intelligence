name: Daily Intelligence Refresh

on:
  schedule:
    # 06:00 UTC = 08:00 Madrid (CET) / 07:00 (CEST) — antes de apertura EU
    - cron: "0 6 * * *"
  workflow_dispatch: {}  # permite disparar manualmente desde Actions tab

permissions:
  contents: write  # necesario para commitear headlines.json

jobs:
  refresh:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node 20
        uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: "npm"

      - name: Install dependencies
        run: npm ci

      - name: Generate headlines
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        run: npm run generate

      - name: Commit & push if changed
        run: |
          git config user.name  "zrc-bot"
          git config user.email "bot@zenithrisecapital.com"
          git add public/data/headlines.json
          if git diff --cached --quiet; then
            echo "No changes to commit"
          else
            git commit -m "chore: daily intelligence refresh [skip ci]"
            git push
          fi
